{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GRADLE_OPTS": "-Djava.net.preferIPv4Stack=true -Xmx2048m",
        "JAVA_TOOL_OPTIONS": "-Djava.net.preferIPv4Stack=true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
